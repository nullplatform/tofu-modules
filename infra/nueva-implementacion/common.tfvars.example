#
# Common Variables - Shared across all layers
#
# Usage: tofu plan -var-file=../common.tfvars -var-file=./terraform.tfvars
#

# AWS Configuration
aws_region  = "us-east-1"
aws_profile = "my-aws-profile"

# Nullplatform Configuration
organization = "my-org"
account      = "my-account"
domain_name  = "example.com"
np_api_key   = "<nullplatform-api-key>"
nrn          = "organization=my-org:account=my-account"

# Backend Configuration (existing S3 backend)
backend_bucket = "<existing-s3-bucket-name>"

# Tags Selectors (shared between infrastructure and nullplatform-bindings)
tags_selectors = {
  "cloud"   = "aws"
  "region"  = "us-east-1"
  "account" = "my-account"
}
